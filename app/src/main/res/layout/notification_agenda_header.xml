<?xml version="1.0" encoding="utf-8"?>
<!-- A day header in the expanded notification's agenda ("Sun (10/4)"): bold and in the
     primary text colour so it stands apart from the grey times beneath it. The row is
     taller than its text, which leaves a little space above each day. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_header_label"
    style="@style/TextAppearance.Compat.Notification.Title"
    android:layout_width="match_parent"
    android:layout_height="22dp"
    android:gravity="bottom"
    android:maxLines="1"
    android:textSize="13sp"
    android:textStyle="bold" />
