<?xml version="1.0" encoding="utf-8"?>
<!-- One event in the expanded notification's agenda: time, calendar dot, title. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notification_row"
    android:layout_width="match_parent"
    android:layout_height="20dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/notification_row_time"
        style="@style/TextAppearance.Compat.Notification.Info"
        android:layout_width="56dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:textSize="12sp" />

    <ImageView
        android:id="@+id/notification_row_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/notification_dot" />

    <TextView
        android:id="@+id/notification_row_title"
        style="@style/TextAppearance.Compat.Notification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="13sp" />
</LinearLayout>
